# ---------- Required in production ----------
NODE_ENV=production
PORT=3000
# Your public https URL (used in emails, CSRF origin check, secure cookies)
APP_URL=https://track.yourdomain.com
# Set to true when running behind a reverse proxy / platform load balancer (Render, Fly, Railway, nginx...)
TRUST_PROXY=true

# ---------- First-boot admin (only used when the users table is empty) ----------
# Remove ADMIN_PASSWORD from the environment after the first successful start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=you@yourdomain.com
ADMIN_NAME=Your Name

# ---------- Email (https://resend.com: verify your domain, create an API key) ----------
RESEND_API_KEY=
EMAIL_FROM="Apex Logistics <notifications@yourdomain.com>"
SUPPORT_EMAIL=support@yourdomain.com
# Staff mailbox that is alerted about new booking requests / contact messages
STAFF_NOTIFY_EMAIL=ops@yourdomain.com

# ---------- Storage ----------
# SQLite file. In Docker/PaaS this MUST point at a persistent volume (e.g. /data/apex.db)
DATABASE_PATH=data/apex.db
BACKUP_DIR=data/backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# ---------- Optional ----------
BRAND_NAME=Apex Global Logistics
SESSION_HOURS=8
# Inserts the 4 sample shipments on boot. Staging/demo only, keep false in production.
SEED_DEMO_DATA=false
